# Milaan — environment variables
# Copy this file to .env.local (it is git-ignored) and fill in your values.

# ── AI: Voice transcription (Groq Whisper) ───────────────────────────────────
# Free API key at https://console.groq.com — no credit card required.
# Used by the Voice Studio modal to transcribe artisan speech to text.
VITE_GROQ_API_KEY=your-groq-api-key-here

# ── AI: Listing generation (OpenRouter) ──────────────────────────────────────
# Free API key at https://openrouter.ai — no credit card required.
# Always use a model with the `:free` suffix to avoid unexpected charges.
# Recommended: qwen/qwen3-235b-a22b:free  (best Indian language support)
#          or: google/gemma-4-31b-it:free  (fast + multilingual)
VITE_OPENROUTER_API_KEY=your-openrouter-api-key-here
VITE_OPENROUTER_MODEL=qwen/qwen3-235b-a22b:free

# ── Gemini (legacy proxy — optional fallback) ─────────────────────────────────
# Get one at https://aistudio.google.com/apikey.
# Without it the voice flow falls back to the offline example listing.
# Also set this on Vercel: Settings → Environment Variables.
GEMINI_API_KEY=your-gemini-api-key-here

# ── App-wide footer constants (leave empty to suppress the section) ───────────
TEAM_EMAIL=
HACKATHON_NAME=
